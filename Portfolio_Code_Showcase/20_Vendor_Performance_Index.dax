// ==========================================================================
// GPI Pillar 2 (Trend)
// Model folder: 06 - GPI / 6.1 - Components
// --------------------------------------------------------------------------
// Purpose: Which direction it is moving.
// Why it exists: Kept separate so a strong-but-declining market never reads
// the same as a weak-but-improving one.
// ==========================================================================

VAR t1 = [GPI P2 - New Leases (Scaled)]
VAR t2 = [GPI P2 - Cost per Lease (Scaled)]
VAR t3 = [GPI P2 - Cost per Lead (Scaled)]
VAR t4 = [GPI P2 - Net Absorption (Scaled)]
VAR t5 = [GPI P2 - Lease Velocity (Scaled)]

VAR TotalWeight =
    IF ( NOT ISBLANK ( t1 ), 24, 0 ) +
    IF ( NOT ISBLANK ( t2 ), 20, 0 ) +
    IF ( NOT ISBLANK ( t3 ), 20, 0 ) +
    IF ( NOT ISBLANK ( t4 ), 20, 0 ) +
    IF ( NOT ISBLANK ( t5 ), 16, 0 )

RETURN
IF (
    TotalWeight = 0,
    BLANK (),
    DIVIDE (
        IF ( ISBLANK ( t1 ), 0, t1 * 24 ) +
        IF ( ISBLANK ( t2 ), 0, t2 * 20 ) +
        IF ( ISBLANK ( t3 ), 0, t3 * 20 ) +
        IF ( ISBLANK ( t4 ), 0, t4 * 20 ) +
        IF ( ISBLANK ( t5 ), 0, t5 * 16 ),
        TotalWeight
    ) * 100
)
