// ==========================================================================
// Lease Expirations (Next 60D)
// Model folder: 01 - Actual / 1.3 - Time Series
// --------------------------------------------------------------------------
// Purpose: Forward expiry volume.
// Why it exists: Read from a pre-computed fact column rather than calculated
// per query, which keeps the forward window cheap.
// ==========================================================================

VAR AsOfDate = MAX('dim_date'[Date])
RETURN
CALCULATE(
    SUMX(
        VALUES(fact_property_ops_daily[PropertyKey]),
        CALCULATE(
            MAX(fact_property_ops_daily[LeaseExpirations_Next60D])
        )
    ),
    'dim_date'[Date] = AsOfDate
)
