// ==========================================================================
// Absorption Days (Est)
// Model folder: 01 - Actual / 1.2 - KPI
// --------------------------------------------------------------------------
// Purpose: Days to absorb current vacancy at recent pace.
// Why it exists: Replaced days-on-market in the OPI pillars: it accounts for
// both inventory and demand.
// ==========================================================================

VAR VacantUnits = [Vacant Ready Units (Est)]
VAR DaysBack = 30
VAR TotalLeases30D =
    CALCULATE(
        SUM(fact_property_ops_daily[MoveIns]),  -- Use SUM directly, not [Move-Ins]
        DATESINPERIOD('dim_date'[Date], MAX('dim_date'[Date]), -DaysBack, DAY)
    )
VAR AvgDailyLeases = DIVIDE(TotalLeases30D, DaysBack)
VAR Days = DIVIDE(VacantUnits, AvgDailyLeases)
RETURN
IF(ISBLANK(Days), BLANK(), MIN(Days, 180))
