// ==========================================================================
// Ops Index - Weakest Component
// Model folder: 04 - Ops Index / 4.1 - Components
// --------------------------------------------------------------------------
// Purpose: Which driver is hurting operations.
// Why it exists: Turns a composite back into its cause, which is what makes
// a score actionable.
// ==========================================================================

VAR Occ = [Ops Index - Occupancy]
VAR Vac = [Ops Index - Vacancy]
VAR Abs = [Ops Index - Absorption]
VAR Cov = [Ops Index - Coverage]
VAR Vel = [Ops Index - Lease Velocity]
VAR Net = [Ops Index - Net Absorption]
VAR SLA = [Ops Index - SLA Compliance]

VAR MinScore = MIN(Occ, MIN(Vac, MIN(Abs, MIN(Cov, MIN(Vel, MIN(Net, SLA))))))

RETURN
SWITCH(
    TRUE(),
    MinScore = Occ, "Occupancy Rate",
    MinScore = Vac, "Vacancy Management",
    MinScore = Abs, "Absorption Speed",
    MinScore = Cov, "Coverage Ratio",
    MinScore = Vel, "Lease Velocity",
    MinScore = Net, "Net Absorption",
    MinScore = SLA, "SLA Compliance",
    BLANK()
)
