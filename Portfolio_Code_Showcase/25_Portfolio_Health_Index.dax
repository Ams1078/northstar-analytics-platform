// ==========================================================================
// GPI Rank (Dynamic)
// Model folder: 06 - GPI / 6.3 - Score / 6.3.1 - Final Score
// --------------------------------------------------------------------------
// Purpose: Rank at whichever geography is selected.
// Why it exists: One measure serving region, market and property instead of
// three parallel ones.
// ==========================================================================

VAR _IsProperty = HASONEVALUE(dim_property[PropertyKey])
VAR _IsMarket   = HASONEVALUE(dim_property[MarketAbbrev]) && NOT _IsProperty
VAR _IsRegion   = HASONEVALUE(dim_property[RegionAbbrev]) && NOT _IsMarket && NOT _IsProperty

-- ── Property ──────────────────────────────────────────────────
VAR _PropertyRank =
    VAR _CurKey   = SELECTEDVALUE(dim_property[PropertyKey])
    VAR _CurScore = CALCULATE([GPI Score], ALL(dim_property), dim_property[PropertyKey] = _CurKey)
    RETURN
    IF(ISBLANK(_CurScore), BLANK(),
        RANKX(
            ALL(dim_property[PropertyKey]),
            CALCULATE([GPI Score], ALL(dim_property), dim_property[PropertyKey] = _CurKey),
            _CurScore,
            DESC,
            DENSE
        )
    )

-- ── Market ────────────────────────────────────────────────────
VAR _MarketRank =
    VAR _CurKey   = SELECTEDVALUE(dim_property[MarketKey])
    VAR _CurScore = CALCULATE([GPI Score], ALL(dim_property), dim_property[MarketKey] = _CurKey)
    RETURN
    IF(ISBLANK(_CurScore), BLANK(),
        RANKX(
            ALL(dim_property[MarketKey]),
            CALCULATE([GPI Score], ALL(dim_property), dim_property[MarketKey] = SELECTEDVALUE(dim_property[MarketKey])),
            _CurScore,
            DESC,
            DENSE
        )
    )

-- ── Region ────────────────────────────────────────────────────
VAR _RegionRank =
    VAR _CurKey   = SELECTEDVALUE(dim_property[RegionKey])
    VAR _CurScore = CALCULATE([GPI Score], ALL(dim_property), dim_property[RegionKey] = _CurKey)
    RETURN
    IF(ISBLANK(_CurScore), BLANK(),
        RANKX(
            ALL(dim_property[RegionKey]),
            CALCULATE([GPI Score], ALL(dim_property), dim_property[RegionKey] = SELECTEDVALUE(dim_property[RegionKey])),
            _CurScore,
            DESC,
            DENSE
        )
    )

RETURN
SWITCH(
    TRUE(),
    _IsProperty, _PropertyRank,
    _IsMarket,   _MarketRank,
    _IsRegion,   _RegionRank,
    BLANK()
)
