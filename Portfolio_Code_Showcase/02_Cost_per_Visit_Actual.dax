// ==========================================================================
// Sell Rate
// Model folder: 01 - Actual / 1.2 - KPI
// --------------------------------------------------------------------------
// Purpose: Leases against available inventory.
// Why it exists: Ties marketing output back to physical capacity.
// ==========================================================================

VAR DaysInFilter =
    DATEDIFF(MIN(dim_date[Date]), MAX(dim_date[Date]), DAY) + 1
RETURN
DIVIDE(
    [New Leases (Actual)],
    [Total Units]
) * (30 / DaysInFilter)
