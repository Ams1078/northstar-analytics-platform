// ==========================================================================
// Occupied Units
// Model folder: 00 - Core Metrics / 1,3 Occupancy
// --------------------------------------------------------------------------
// Purpose: Units occupied at the snapshot.
// Why it exists: Semi-additive: read at a point in time, never summed across
// dates.
// ==========================================================================

VAR AsOfDate = MAX('dim_date'[Date])
RETURN
SUMX(
    VALUES(dim_property[PropertyKey]),
    CALCULATE(
        MAX(fact_property_ops_daily[OccupiedUnits]),
        KEEPFILTERS('dim_date'[Date] = AsOfDate)
    )
)
