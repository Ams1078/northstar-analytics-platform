// ==========================================================================
// Available Units
// Model folder: 01 - Actual / 1.1 - Base
// --------------------------------------------------------------------------
// Purpose: Units available to lease.
// Why it exists: Narrower than vacant: excludes units not yet ready.
// ==========================================================================

VAR AsOfDate = MAX('dim_date'[Date])
RETURN
CALCULATE(
    SUMX(
        VALUES(fact_property_ops_daily[PropertyKey]),
        CALCULATE(
            MAX(fact_property_ops_daily[AvailableUnits])
        )
    ),
    'dim_date'[Date] = AsOfDate
)
