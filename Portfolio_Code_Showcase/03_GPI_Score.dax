// ==========================================================================
// Portfolio Health Index
// Model folder: 05 - Portfolio Health / 5.2 - KPI
// --------------------------------------------------------------------------
// Purpose: Portfolio Health Index, 0-100.
// Why it exists: Note the weights in this code are 0.35 / 0.35 / 0.30. The
// designed framework is 0.45 GPI / 0.30 OPI / 0.25 VPI, and the model is
// mid-migration. The re-weighting of the denominator when a pillar is blank
// is the part worth studying: a missing pillar rescales rather than silently
// scoring zero.
// ==========================================================================

VAR P1 = [Portfolio Health - Operations]
VAR P2 = [Portfolio Health - Marketing Funnel]
VAR P3 = [Portfolio Health - Geo Marketing]

VAR TotalWeight =
    IF(NOT ISBLANK(P1), 0.35, 0) +
    IF(NOT ISBLANK(P2), 0.35, 0) +
    IF(NOT ISBLANK(P3), 0.30, 0)

VAR WeightedSum =
    IF(ISBLANK(P1), 0, P1 * 0.35) +
    IF(ISBLANK(P2), 0, P2 * 0.35) +
    IF(ISBLANK(P3), 0, P3 * 0.30)

RETURN
IF(
    TotalWeight = 0,
    BLANK(),
    DIVIDE(WeightedSum, TotalWeight)
)
