// ==========================================================================
// Callout - Highest CPL
// Model folder: 01 - Actual / 1.2 - KPI
// --------------------------------------------------------------------------
// Purpose: The costliest acquisition, named.
// Why it exists: Specific enough to act on, without instructing.
// ==========================================================================

VAR TopMarket =
    TOPN(
        1,
        VALUES(dim_property[MarketName]),
        CALCULATE([Cost per Lease (Actual)]),
        DESC
    )
VAR MarketName = MAXX(TopMarket, dim_property[MarketName])
VAR CPL        = MAXX(TopMarket, CALCULATE([Cost per Lease (Actual)]))
RETURN
IF(
    ISBLANK(MarketName), BLANK(),
    "⚠️ " & MarketName &
    " — CPL " & FORMAT(CPL, "$#,0")
)
