// ==========================================================================
// Insight – Vendor to Watch
// Model folder: 02 - Funnel / 2.4 - Insights
// --------------------------------------------------------------------------
// Purpose: The vendor to monitor.
// Why it exists: Volatility rather than level, so a vendor that is fine on
// average but unstable still surfaces.
// ==========================================================================

VAR _Mode      = SELECTEDVALUE('Parameter Chanel Vendor View'[Chanel Vendor View Order], 0)
VAR _MaxDate   = MAX(dim_date[Date])
VAR _PriorEnd  = DATE(YEAR(_MaxDate), MONTH(_MaxDate) - 1, DAY(_MaxDate))
VAR _PriorStart = DATE(YEAR(_MaxDate), MONTH(_MaxDate) - 2, DAY(_MaxDate))
-- CHANNEL MODE
VAR _CurC =
    ADDCOLUMNS(
        ALLSELECTED('dim_vendor'[ChannelName]),
        "@VPIc",  CALCULATE([Vendor Performance Index]),
        "@Spend", CALCULATE([Marketing Spend])
    )
VAR _PrvC =
    ADDCOLUMNS(
        ALLSELECTED('dim_vendor'[ChannelName]),
        "@VPIp",
        CALCULATE(
            [Vendor Performance Index],
            DATESBETWEEN(dim_date[Date], _PriorStart, _PriorEnd)
        )
    )
VAR _ComC =
    ADDCOLUMNS(
        FILTER(_CurC, NOT ISBLANK([@VPIc]) && [@Spend] > 0),
        "@VPIp",
        MAXX(
            FILTER(_PrvC, 'dim_vendor'[ChannelName] = EARLIER('dim_vendor'[ChannelName])),
            [@VPIp]
        )
    )
VAR _DelC  = ADDCOLUMNS(FILTER(_ComC, NOT ISBLANK([@VPIp])), "@D", [@VPIc] - [@VPIp])
VAR _WatC  = TOPN(1, FILTER(_DelC, NOT ISBLANK([@D])), [@D], ASC)
VAR _NC    = MAXX(_WatC, 'dim_vendor'[ChannelName])
VAR _VIC   = MAXX(_WatC, [@VPIc])
VAR _DC    = MAXX(_WatC, [@D])
VAR _RC    =
    IF(ISBLANK(_NC) || _DC >= 0, BLANK(),
        UNICHAR(9888) & " " & _NC &
        " · VPI " & FORMAT(_VIC, "0.0") &
        " (" & FORMAT(_DC, "+0.0;-0.0") & " vs prior mo)"
    )
-- VENDOR MODE
VAR _CurV =
    ADDCOLUMNS(
        ALLSELECTED('dim_vendor'[VendorName]),
        "@VPIc",  CALCULATE([Vendor Performance Index]),
        "@Spend", CALCULATE([Marketing Spend])
    )
VAR _PrvV =
    ADDCOLUMNS(
        ALLSELECTED('dim_vendor'[VendorName]),
        "@VPIp",
        CALCULATE(
            [Vendor Performance Index],
            DATESBETWEEN(dim_date[Date], _PriorStart, _PriorEnd)
        )
    )
VAR _ComV =
    ADDCOLUMNS(
        FILTER(_CurV, NOT ISBLANK([@VPIc]) && [@Spend] > 0),
        "@VPIp",
        MAXX(
            FILTER(_PrvV, 'dim_vendor'[VendorName] = EARLIER('dim_vendor'[VendorName])),
            [@VPIp]
        )
    )
VAR _DelV  = ADDCOLUMNS(FILTER(_ComV, NOT ISBLANK([@VPIp])), "@D", [@VPIc] - [@VPIp])
VAR _WatV  = TOPN(1, FILTER(_DelV, NOT ISBLANK([@D])), [@D], ASC)
VAR _NV    = MAXX(_WatV, 'dim_vendor'[VendorName])
VAR _VIV   = MAXX(_WatV, [@VPIc])
VAR _DV    = MAXX(_WatV, [@D])
VAR _RV    =
    IF(ISBLANK(_NV) || _DV >= 0, BLANK(),
        UNICHAR(9888) & " " & _NV &
        " · VPI " & FORMAT(_VIV, "0.0") &
        " (" & FORMAT(_DV, "+0.0;-0.0") & " vs prior mo)"
    )
RETURN SWITCH(_Mode, 0, _RC, 1, _RV, _RC)
