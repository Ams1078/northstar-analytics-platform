// ==========================================================================
// Matrix Metric 1
// Model folder: 10 - Parameters & Helpers / 10.2 - Slicer & Parameters
// --------------------------------------------------------------------------
// Purpose: First column of a field-parameter matrix.
// Why it exists: Lets one visual serve several metrics without duplicating
// the visual.
// ==========================================================================

SWITCH(
    SELECTEDVALUE('Parameter Metric View'[Metric], "Volume"),
    "Volume", [CTR %],
    "Spend",  [Cost per Click]
)
