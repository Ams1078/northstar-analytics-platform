// ==========================================================================
// New Leases (Last 30D)
// Model folder: 01 - Actual / 1.3 - Time Series
// --------------------------------------------------------------------------
// Purpose: Trailing lease pace.
// Why it exists: Time intelligence over a rolling window rather than a
// calendar period.
// ==========================================================================

VAR DaysBack = 30
RETURN
CALCULATE(
    [New Leases (Actual)],   -- primary operational lease metric
    DATESINPERIOD(
        'dim_date'[Date],
        MAX('dim_date'[Date]),
        -DaysBack,
        DAY
    )
)
