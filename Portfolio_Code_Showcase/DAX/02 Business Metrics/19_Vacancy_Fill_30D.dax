// ==========================================================================
// Vacancy Fill % (30D)
// Model folder: 01 - Actual / 1.3 - Time Series
// --------------------------------------------------------------------------
// Purpose: How quickly vacancy is absorbed.
// Why it exists: Now a diagnostic rather than a pillar input, after
// Absorption Days replaced it.
// ==========================================================================

VAR AvailableToFill = [Vacant Ready Units (Est)]
VAR ActualFillRate = DIVIDE([Move-Ins], [Move-Ins] + AvailableToFill)
RETURN
IF(
    AvailableToFill < 3, BLANK(),
    MIN(1, ActualFillRate)
)
