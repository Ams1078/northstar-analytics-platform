// ==========================================================================
// Scheduled Move-Ins (Next 60D)
// Model folder: 01 - Actual / 1.3 - Time Series
// --------------------------------------------------------------------------
// Purpose: Forward committed arrivals.
// Why it exists: Numerator of the coverage ratio.
// ==========================================================================

VAR AsOfDate =
    MAX ( 'dim_date'[Date] )
RETURN
SUMX (
    VALUES ( dim_property[PropertyKey] ),
    CALCULATE (
        MAX ( fact_property_ops_daily[ScheduledMoveIns_Next60D] ),
        KEEPFILTERS ( 'dim_date'[Date] = AsOfDate )
    )
)
