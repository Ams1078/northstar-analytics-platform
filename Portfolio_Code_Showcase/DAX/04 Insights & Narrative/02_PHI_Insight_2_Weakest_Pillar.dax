// ==========================================================================
// PHI Insight 2 - Weakest Pillar
// Model folder: 05 - Portfolio Health / 5.1 - Components
// --------------------------------------------------------------------------
// Purpose: Names the largest drag.
// Why it exists: Paired with the strength so a reader gets both sides
// without navigating.
// ==========================================================================

VAR P1 = [Portfolio Health - Operations]
VAR P2 = [Portfolio Health - Marketing Funnel]
VAR P3 = [Portfolio Health - Geo Marketing]
VAR Worst = MIN(P1, MIN(P2, P3))

-- Pillar 1 components
VAR c_occ = MIN(MAX(([Occupancy Rate %] - 0.605) / (0.933 - 0.605) * 100, 0), 100)
VAR c_abs = MIN(MAX((1 - ([Absorption Days (Est)] - 20.56) / (166.2 - 20.56)) * 100, 0), 100)
VAR c_cov = MIN(MAX(([Coverage Ratio (Next 60D)] - 0.606) / (2.290 - 0.606) * 100, 0), 100)

-- Pillar 2 components
VAR c_cpl = MIN(MAX((1 - (DIVIDE([Marketing Spend], [New Leases (Actual)]) - 684.9) / (1071.9 - 684.9)) * 100, 0), 100)
VAR c_vel = MIN(MAX(([Lease Velocity] - 0.0073) / (0.0536 - 0.0073) * 100, 0), 100)
VAR c_net = MIN(MAX((DIVIDE([Net Absorption], [Total Units], 0) - (-0.8115)) / (0.0483 - (-0.8115)) * 100, 0), 100)

-- Pillar 3 components
VAR c_l2l = MIN(MAX(([Lead-to-Lease % (Actual)] - 0.1323) / (0.1398 - 0.1323) * 100, 0), 100)

-- Lowest scoring component within the weakest pillar
VAR DragMetric =
    SWITCH(
        TRUE(),
        Worst = P1, SWITCH(TRUE(),
            c_occ <= c_abs && c_occ <= c_cov, "Occupancy Rate",
            c_abs <= c_occ && c_abs <= c_cov, "Absorption Days",
            "Coverage Ratio"),
        Worst = P2, SWITCH(TRUE(),
            c_cpl <= c_vel && c_cpl <= c_net, "Cost per Lease",
            c_vel <= c_cpl && c_vel <= c_net, "Lease Velocity",
            "Net Absorption"),
        Worst = P3, IF(c_l2l <= c_cov, "Lead-to-Lease %", "Coverage Ratio"),
        "—"
    )

-- Actual current value of the dragging metric
VAR DragValue =
    SWITCH(
        DragMetric,
        "Occupancy Rate",  FORMAT([Occupancy Rate %], "0.0%"),
        "Absorption Days", FORMAT([Absorption Days (Est)], "#,0") & " days",
        "Coverage Ratio",  FORMAT([Coverage Ratio (Next 60D)], "0.00"),
        "Cost per Lease",  FORMAT(DIVIDE([Marketing Spend], [New Leases (Actual)]), "$#,0"),
        "Lease Velocity",  FORMAT([Lease Velocity], "0.000"),
        "Net Absorption",  FORMAT([Net Absorption], "+#,0;-#,0;0"),
        "Lead-to-Lease %", FORMAT([Lead-to-Lease % (Actual)], "0.0%"),
        "—"
    )

RETURN
IF(
    ISBLANK(Worst), BLANK(),
    "⚠ Weakest: " & DragMetric & UNICHAR(10) &
    DragValue
)
