// ==========================================================================
// PHI Insight 4 - Sharpest Decline Pillar
// Model folder: 05 - Portfolio Health / 5.1 - Components
// --------------------------------------------------------------------------
// Purpose: The deterioration to watch.
// Why it exists: Catches decline before it reaches the headline score.
// ==========================================================================

VAR StartDate   = MIN(dim_date[Date])
VAR EndDate     = MAX(dim_date[Date])
VAR DaysInRange = DATEDIFF(StartDate, EndDate, DAY) + 1
VAR PrevStart   = StartDate - DaysInRange
VAR PrevEnd     = EndDate   - DaysInRange
VAR D1 =
    [Portfolio Health - Operations] -
    CALCULATE([Portfolio Health - Operations], DATESBETWEEN(dim_date[Date], PrevStart, PrevEnd))
VAR D2 =
    [Portfolio Health - Marketing Funnel] -
    CALCULATE([Portfolio Health - Marketing Funnel], DATESBETWEEN(dim_date[Date], PrevStart, PrevEnd))
VAR D3 =
    [Portfolio Health - Geo Marketing] -
    CALCULATE([Portfolio Health - Geo Marketing], DATESBETWEEN(dim_date[Date], PrevStart, PrevEnd))
VAR Worst = MIN(D1, MIN(D2, D3))

-- Pillar 1 components
VAR c_occ = MIN(MAX(([Occupancy Rate %] - 0.605) / (0.933 - 0.605) * 100, 0), 100)
VAR c_abs = MIN(MAX((1 - ([Absorption Days (Est)] - 20.56) / (166.2 - 20.56)) * 100, 0), 100)
VAR c_cov = MIN(MAX(([Coverage Ratio (Next 60D)] - 0.606) / (2.290 - 0.606) * 100, 0), 100)

-- Pillar 2 components
VAR c_cpl = MIN(MAX((1 - (DIVIDE([Marketing Spend], [New Leases (Actual)]) - 684.9) / (1071.9 - 684.9)) * 100, 0), 100)
VAR c_vel = MIN(MAX(([Lease Velocity] - 0.0073) / (0.0536 - 0.0073) * 100, 0), 100)
VAR c_net = MIN(MAX((DIVIDE([Net Absorption], [Total Units], 0) - (-0.8115)) / (0.0483 - (-0.8115)) * 100, 0), 100)

-- Pillar 3 components
VAR c_l2l = MIN(MAX(([Lead-to-Lease % (Actual)] - 0.1323) / (0.1398 - 0.1323) * 100, 0), 100)

-- Lowest scoring component within the most declined pillar
VAR WatchMetric =
    SWITCH(
        TRUE(),
        Worst = D1, SWITCH(TRUE(),
            c_occ <= c_abs && c_occ <= c_cov, "Occupancy Rate",
            c_abs <= c_occ && c_abs <= c_cov, "Absorption Days",
            "Coverage Ratio"),
        Worst = D2, SWITCH(TRUE(),
            c_cpl <= c_vel && c_cpl <= c_net, "Cost per Lease",
            c_vel <= c_cpl && c_vel <= c_net, "Lease Velocity",
            "Net Absorption"),
        Worst = D3, IF(c_l2l <= c_cov, "Lead-to-Lease %", "Coverage Ratio"),
        "—"
    )

RETURN
SWITCH(
    TRUE(),
    ISBLANK(Worst), BLANK(),
    -- All pillars improved or flat — show smallest gain as "watch" signal
    Worst >= 0,
        "➡ Stable: " & WatchMetric & UNICHAR(10) &
        "No decline vs prior period",
    -- Actual decline
    "▼ Sharpest Drop: " & WatchMetric & UNICHAR(10) &
    FORMAT(Worst, "0.0") & " pts vs prior period"
)
