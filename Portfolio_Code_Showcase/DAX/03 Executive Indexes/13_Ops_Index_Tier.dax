// ==========================================================================
// Ops Index Tier
// Model folder: 04 - Ops Index / 4.3 - Score / 4.3.2 - Tiers & Labels
// --------------------------------------------------------------------------
// Purpose: Tier label for OPI.
// Why it exists: Same fixed-threshold pattern as GPI, for consistency across
// indexes.
// ==========================================================================

VAR Score = [Operations Index Score]
RETURN
SWITCH(
    TRUE(),
    ISBLANK(Score), BLANK(),
    Score >= 86.3,  UNICHAR(11088) & " Excellent",
    Score >= 79.3,  UNICHAR(9989)  & " Good",
    Score >= 60.0,  UNICHAR(9888)  & " Average",
    Score >= 49.2,  UNICHAR(128308) & " Below Average",
                    UNICHAR(128308) & " Critical"
)
