// ==========================================================================
// GPI vs Portfolio
// Model folder: 06 - GPI / 6.2 - KPI
// --------------------------------------------------------------------------
// Purpose: A market against the portfolio.
// Why it exists: Turns an absolute score into a relative position.
// ==========================================================================

VAR ScoreVal = [GPI Score]
VAR PortAvg =
    CALCULATE(
        AVERAGEX(VALUES(dim_property[MarketKey]), [GPI Score]),
        ALL(dim_property[MarketKey])
    )
RETURN IF(ISBLANK(ScoreVal) || ISBLANK(PortAvg), BLANK(), ScoreVal - PortAvg)
