// ==========================================================================
// Portfolio Health - Marketing Funnel
// Model folder: 05 - Portfolio Health / 5.2 - KPI
// --------------------------------------------------------------------------
// Purpose: Funnel contribution to PHI.
// Why it exists: Built from cost and conversion primitives rather than from
// VPI, keeping PHI independent of vendor mix.
// ==========================================================================

VAR L2L_V   = [Lead-to-Lease % (Funnel)]
VAR CPL_V   = [Cost per Lease (Vendor)]
VAR NL_V    = [New Leases (Funnel)]
VAR CPV_V   = [Cost per Visit (Vendor)]
VAR Visits  = [Visits (Funnel)]

-- Lead-to-Lease % (Vendor): 3% → 15%
VAR s_l2l = MIN(MAX((L2L_V - 0.03) / (0.15 - 0.03) * 100, 0), 100)

-- Cost per Lease (Vendor): $2,000 → $150 (inverted)
VAR s_cpl = MIN(MAX((1 - (CPL_V - 150) / (2000 - 150)) * 100, 0), 100)

-- New Leases (Vendor): 0 → 2,000
VAR s_nl  = MIN(MAX((NL_V - 0) / (2000 - 0) * 100, 0), 100)

-- Cost per Visit (Vendor): $50 → $5 (inverted)
VAR s_cpv = MIN(MAX((1 - (CPV_V - 5) / (50 - 5)) * 100, 0), 100)

-- Visits (Funnel): 1,000 → 50,000
VAR s_vis = MIN(MAX((Visits - 1000) / (50000 - 1000) * 100, 0), 100)

VAR Pillar2 =
    s_l2l * 0.25 +
    s_cpl * 0.25 +
    s_nl  * 0.20 +
    s_cpv * 0.15 +
    s_vis * 0.15

RETURN
IF(
    ISBLANK(L2L_V) || ISBLANK(CPL_V) || ISBLANK(Visits),
    BLANK(),
    Pillar2
)
