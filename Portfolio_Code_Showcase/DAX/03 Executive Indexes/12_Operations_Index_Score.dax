// ==========================================================================
// Operations Index Score
// Model folder: 04 - Ops Index / 4.3 - Score / 4.3.1 - Final Score
// --------------------------------------------------------------------------
// Purpose: Operations Performance Index, 0-100.
// Why it exists: Each measure is min-max scaled against calibrated bands,
// then weighted. The bands are explicit in the code rather than hidden in a
// parameter table.
// ==========================================================================

VAR OccupancyScore =
    VAR OccRate = [Occupancy Rate %]
    VAR Score = (OccRate - 0.605) / (0.933 - 0.605) * 100
    RETURN MIN(MAX(Score, 0), 100) * 0.20

VAR VacancyScore =
    VAR VacantUnits = [Vacant Ready Units (Est)]
    VAR TotalUnits = [Total Units]
    VAR VacancyRate = DIVIDE(VacantUnits, TotalUnits)
    VAR Score = (1 - (VacancyRate - 0.067) / (0.395 - 0.067)) * 100
    RETURN MIN(MAX(Score, 0), 100) * 0.10

VAR AbsorptionScore =
    VAR Days = [Absorption Days (Est)]
    VAR Score = (1 - (Days - 20.56) / (166.2 - 20.56)) * 100
    RETURN MIN(MAX(Score, 0), 100) * 0.15

VAR CoverageScore =
    VAR CovRatio = [Coverage Ratio (Next 60D)]
    VAR Score = MIN((CovRatio - 0.45) / (0.95 - 0.45) * 100, 100)
    RETURN MAX(Score, 0) * 0.20

VAR LeaseVelocityScore =
    VAR Vel = [Lease Velocity]
    VAR Score = (Vel - 0.0073) / (0.0536 - 0.0073) * 100
    RETURN MIN(MAX(Score, 0), 100) * 0.15

VAR NetAbsorptionScore =
    VAR NetAbs = DIVIDE([Net Absorption], [Total Units], 0)
    VAR Score = (NetAbs - (-0.8115)) / (0.0483 - (-0.8115)) * 100
    RETURN MIN(MAX(Score, 0), 100) * 0.10

VAR SLAScore =
    VAR SLA = IF([Within SLA] = "Yes", 1, 0)
    RETURN SLA * 100 * 0.10

RETURN
    OccupancyScore +
    VacancyScore +
    AbsorptionScore +
    CoverageScore +
    LeaseVelocityScore +
    NetAbsorptionScore +
    SLAScore
