// ==========================================================================
// _VPI_SingleVendor_Score
// Model folder: 07 - VPI / 7.4 - Helpers
// --------------------------------------------------------------------------
// Purpose: One vendor's weighted funnel score.
// Why it exists: Underscore-prefixed: an internal helper never placed on a
// visual. Isolating it keeps the public measure thin.
// ==========================================================================

-- Expects single vendor context.
-- Weights only the stages the vendor participates in.
-- Returns 0–100. No ratio-vs-average, no cap.

VAR A = [Awareness Score]      -- BLANK for Email, SEO, etc.
VAR C = [Consideration Score]
VAR E = [Evaluation Score]
VAR V = [Conversion Score]

-- Only include stages that have data
VAR A_Wt = IF(NOT ISBLANK(A), 0.15, 0)
VAR C_Wt = IF(NOT ISBLANK(C), 0.20, 0)
VAR E_Wt = IF(NOT ISBLANK(E), 0.25, 0)
VAR V_Wt = IF(NOT ISBLANK(V), 0.40, 0)

VAR TotalWt = A_Wt + C_Wt + E_Wt + V_Wt

VAR WeightedSum =
    IF(NOT ISBLANK(A), A * A_Wt, 0) +
    IF(NOT ISBLANK(C), C * C_Wt, 0) +
    IF(NOT ISBLANK(E), E * E_Wt, 0) +
    IF(NOT ISBLANK(V), V * V_Wt, 0)

RETURN
IF(TotalWt = 0, BLANK(), DIVIDE(WeightedSum, TotalWt))
