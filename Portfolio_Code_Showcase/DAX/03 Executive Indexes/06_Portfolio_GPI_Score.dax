// ==========================================================================
// Portfolio GPI Score
// Model folder: 06 - GPI / 6.3 - Score / 6.3.1 - Final Score
// --------------------------------------------------------------------------
// Purpose: Portfolio-level GPI.
// Why it exists: Computed at portfolio grain rather than averaged from
// market scores, which would weight a small market equally with a large one.
// ==========================================================================

CALCULATE(
    [Geography Score], REMOVEFILTERS(dim_market),
    REMOVEFILTERS(dim_property),
    REMOVEFILTERS(dim_region)
)
