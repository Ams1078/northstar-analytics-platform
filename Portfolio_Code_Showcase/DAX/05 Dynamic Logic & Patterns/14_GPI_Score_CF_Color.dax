// ==========================================================================
// GPI Score - CF Color
// Model folder: 06 - GPI / 6.3 - Score / 6.3.3 - Color & Formatting
// --------------------------------------------------------------------------
// Purpose: Conditional formatting colour.
// Why it exists: Formatting logic lives in a measure, not in a visual's
// settings, so it is versioned with the model.
// ==========================================================================

VAR _score = [GPI Score]
RETURN
SWITCH(
    TRUE(),
    ISBLANK(_score),  "#303030",
    _score >= 88.5,   "#1A7A4A",   -- deep green   (Excellent)
    _score >= 83.0,   "#2ECC71",   -- green        (Good)
    _score >= 76.7,   "#A8D44A",   -- yellow-green (Average)
    _score >= 73.4,   "#E8A838",   -- amber        (Below Average)
    _score >= 65.0,   "#E8732A",   -- orange       (approaching Critical)
    "#C0392B"                       -- deep red     (Critical)
)
