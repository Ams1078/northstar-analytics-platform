// ==========================================================================
// Leads (Funnel)
// Model folder: 00 - Core Metrics / 1.1 Funnel Volumes
// --------------------------------------------------------------------------
// Purpose: Leads sourced through the marketing funnel.
// Why it exists: Distinct from Leads (Actual): funnel counts what marketing
// produced, actual counts what the property recorded.
// ==========================================================================

CALCULATE(SUM(fact_marketing_funnel_daily[MetricValue]), dim_funnel_stage[FunnelStageName] = "Leads")
