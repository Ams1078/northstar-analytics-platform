// ==========================================================================
// Occupancy Rate %
// Model folder: 01 - Actual / 1.1 - Base
// --------------------------------------------------------------------------
// Purpose: Occupied over occupied plus vacant.
// Why it exists: First composed measure. DIVIDE returns blank on an empty
// selection instead of erroring.
// ==========================================================================

DIVIDE(
    [Occupied Units],
    [Occupied Units] + [Vacant Units]
)
